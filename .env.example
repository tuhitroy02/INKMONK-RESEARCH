# Copy to .env.local for local development. Never commit real values.
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Google Cloud OAuth web client: register the exact callback URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Resend: verify the sending domain and use a sender on that domain.
RESEND_API_KEY=""
OTP_FROM_EMAIL="InkMonk Research <login@your-verified-domain.com>"

# Twilio Verify: create a Verify service with SMS enabled.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
